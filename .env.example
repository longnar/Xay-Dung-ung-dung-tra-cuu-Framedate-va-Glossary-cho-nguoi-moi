# Database Configuration (Aiven Cloud MySQL / Local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=idol_showdown_wiki
DB_SSL=true

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Server Environment
PORT=5000
NODE_ENV=production
APP_URL=https://your-app-name.onrender.com

# Discord Webhook Security Alert
# Cấu hình Webhook URL từ kênh Discord (Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Cloud Storage (Cloudinary) - Đảm bảo tệp upload không bị mất khi deploy Render
# Cung cấp CLOUDINARY_URL hoặc bộ 3 keys (nếu không cung cấp, hệ thống tự động lưu vào /uploads cục bộ)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Hoặc: CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

